# Which Arc network the build talks to: "testnet" (default) or "mainnet".
NEXT_PUBLIC_ARC_NETWORK=testnet

# Optional: dedicated RPC URLs (e.g. Alchemy/QuickNode) instead of the public ones.
# NEXT_PUBLIC_ARC_TESTNET_RPC_URL=
# NEXT_PUBLIC_ARC_MAINNET_RPC_URL=

# Optional: WalletConnect (Reown) project ID for QR-code / mobile wallets.
# Injected wallets like MetaMask work without it. Free at https://cloud.reown.com
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
